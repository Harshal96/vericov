# Vericov self-host configuration
#
# Quick start:
#   cp .env.example .env
#   ./vericov doctor
#   ./vericov up

# -- Database ---------------------------------------------------------------
# BYO_POSTGRES=0 starts the bundled Postgres container.
# BYO_POSTGRES=1 uses the VERICOV_DB_* values you provide.
BYO_POSTGRES=0
VERICOV_DB_NAME=postgres
VERICOV_DB_URL=
VERICOV_DB_USER=postgres
VERICOV_DB_PASSWORD=change-me
VERICOV_DB_JWT_SECRET=change-me-generate-32-random-bytes
VERICOV_DB_JWT_EXPIRY=3600
VERICOV_POSTGRES_PORT=54329

# -- Supabase ---------------------------------------------------------------
# Self-hosting does not require Supabase Auth. Use skip unless you want the
# bundled Supabase stack for object storage while evaluating locally.
# Values: 0 (bundled Supabase), 1 (bring your own Supabase), skip (none).
BYO_SUPABASE=skip
SUPABASE_URL=
SUPABASE_STORAGE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# -- Coverage artifact storage --------------------------------------------
# Values: filesystem (recommended local default), supabase, memory (tests only).
VERICOV_ARTIFACT_STORAGE_BACKEND=filesystem
VERICOV_ARTIFACT_STORAGE_ROOT=/var/lib/vericov/artifacts
VERICOV_COVERAGE_BUCKET=coverage-raw
VERICOV_TEST_RESULTS_BUCKET=test-results-raw
VERICOV_METADATA_BUCKET=metadata-raw

# -- Service trust ----------------------------------------------------------
# Self-hosting starts with dev auth bypass because there is no auth setup.
# Put Vericov behind your private gateway/network, or set bypass=false and
# provide either VERICOV_SERVICE_JWT_PUBLIC_KEY (external gateway) or
# VERICOV_SERVICE_JWT_SECRET (single-tenant symmetric fallback).
VERICOV_DEV_AUTH_BYPASS=true
VERICOV_DEV_USER_ID=00000000-0000-0000-0000-000000000001
VERICOV_DEV_USER_EMAIL=operator@vericov.local
VERICOV_DEV_TENANT_ID=00000000-0000-0000-0000-000000000001
VERICOV_DEV_REPOSITORY_ID=00000000-0000-0000-0000-000000000003
VERICOV_DEV_API_KEY_ID=
VERICOV_SERVICE_JWT_PUBLIC_KEY=
VERICOV_SERVICE_JWT_SECRET=
VERICOV_SERVICE_JWT_ISSUER=vericov-gateway
VERICOV_SERVICE_JWT_AUDIENCE=vericov

# -- CI upload and runner credentials --------------------------------------
VERICOV_REPO_API_KEY_PEPPER=change-me-generate-32-random-bytes
VERICOV_DEV_API_KEY=vc_repo_local_dev
VERICOV_RUNNER_JWT_SECRET=change-me-generate-32-random-bytes
VERICOV_RUNNER_JWT_ISSUER=vericov-upload
VERICOV_RUNNER_JWT_AUDIENCE=vericov-runner-upload

# -- Webhooks ---------------------------------------------------------------
VERICOV_GITHUB_WEBHOOK_SECRET=change-me-generate-random-webhook-secret

# -- Direct service ports ---------------------------------------------------
VERICOV_UPLOAD_HTTP_PORT=8080
VERICOV_ANALYSIS_HTTP_PORT=8081
VERICOV_CONTROL_PLANE_HTTP_PORT=8082
VERICOV_CONTROL_PLANE_GRPC_PORT=50082
VERICOV_GIT_HTTP_PORT=8083
VERICOV_INTEGRATIONS_HTTP_PORT=8084
VERICOV_AGENT_HTTP_PORT=8085

# -- Local safety limits ----------------------------------------------------
VERICOV_CORS_ORIGIN=*
VERICOV_USER_RATE_LIMIT_MINUTE=120
VERICOV_UPLOAD_RATE_LIMIT_MINUTE=60
VERICOV_UPLOAD_RATE_LIMIT_HOUR=1000
VERICOV_UPLOAD_MAX_BODY_MB=110
VERICOV_WEBHOOK_RATE_LIMIT_MINUTE=120
VERICOV_BADGE_RATE_LIMIT_MINUTE=600
VERICOV_INTERNAL_RATE_LIMIT_MINUTE=120
