# Generated by infra/local/scripts/generate-env.mjs. Copying this file by hand is
# fine for shape discovery, but local secrets should be generated.
POSTGRES_PASSWORD=replace-with-infra-supabase-postgres-password
SUPABASE_SERVICE_ROLE_KEY=replace-with-infra-supabase-service-role-key
SUPABASE_JWT_SECRET=replace-with-infra-supabase-jwt-secret
SUPABASE_JWT_ISSUER=http://localhost:8000/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

SUPABASE_URL=http://kong:8000
SUPABASE_STORAGE_URL=http://kong:8000/storage/v1
SUPABASE_DB_URL=jdbc:postgresql://db:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=replace-with-infra-supabase-postgres-password

VERICOV_REPO_API_KEY_PEPPER=replace-with-generated-pepper
VERICOV_RUNNER_JWT_SECRET=replace-with-generated-runner-secret
VERICOV_RUNNER_JWT_ISSUER=vericov-upload
VERICOV_RUNNER_JWT_AUDIENCE=vericov-runner-upload
VERICOV_INTERNAL_SERVICE_TOKEN=replace-with-generated-service-token
VERICOV_INTERNAL_SERVICE_TOKEN_SHA256=git-integration=replace-with-sha256,coverage-analysis=replace-with-sha256,organization=replace-with-sha256
VERICOV_GITHUB_WEBHOOK_SECRET=replace-with-generated-webhook-secret

VERICOV_CORS_ORIGIN=*
VERICOV_USER_RATE_LIMIT_MINUTE=120
VERICOV_UPLOAD_RATE_LIMIT_MINUTE=60
VERICOV_UPLOAD_RATE_LIMIT_HOUR=1000
VERICOV_UPLOAD_MAX_BODY_MB=110
VERICOV_WEBHOOK_RATE_LIMIT_MINUTE=120
VERICOV_BADGE_RATE_LIMIT_MINUTE=600
VERICOV_INTERNAL_RATE_LIMIT_MINUTE=120
