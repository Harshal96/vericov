# Vericov product gateway ports. Bind to loopback for local development.
VERICOV_KONG_HTTP_PORT=9000
VERICOV_KONG_ADMIN_PORT=9001

# Local Helidon services. Docker Desktop resolves host.docker.internal automatically;
# Linux uses the extra_hosts mapping in docker-compose.yml.
ORGANIZATION_SERVICE_URL=http://host.docker.internal:8082
UPLOAD_SERVICE_URL=http://host.docker.internal:8080
COVERAGE_ANALYSIS_SERVICE_URL=http://host.docker.internal:8081
GIT_INTEGRATION_SERVICE_URL=http://host.docker.internal:8083

# Public API guardrails.
VERICOV_CORS_ORIGIN=*
VERICOV_UPLOAD_RATE_LIMIT_MINUTE=60
VERICOV_UPLOAD_RATE_LIMIT_HOUR=1000
VERICOV_UPLOAD_MAX_BODY_MB=110
VERICOV_PUBLIC_RATE_LIMIT_MINUTE=120
VERICOV_INTERNAL_RATE_LIMIT_MINUTE=120
