# Copy this file to .env or run: node scripts/generate-env.mjs
#
# Never commit .env. All blank secrets below are required for a real boot.

COMPOSE_FILE=docker-compose.yml

# Secrets
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=
SECRET_KEY_BASE=
VAULT_ENC_KEY=
PG_META_CRYPTO_KEY=
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=

# Optional new self-hosted opaque/asymmetric API key settings.
# Keep blank for the initial legacy-HS256 local stack.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

# URLs
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=

# Database
POSTGRES_DB=postgres
POSTGRES_HOST_PORT=54322
JWT_EXPIRY=3600

# API gateway
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# Studio
STUDIO_DEFAULT_ORGANIZATION=Vericov
STUDIO_DEFAULT_PROJECT=Vericov Local

# Auth
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=Vericov
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# Vericov service auth
# Used by the upload service to HMAC-hash repository API keys before storing them.
VERICOV_REPO_API_KEY_PEPPER=
# Used by the upload service to issue/verify short-lived runner upload JWTs.
VERICOV_RUNNER_JWT_SECRET=
VERICOV_RUNNER_JWT_ISSUER=vericov-upload
VERICOV_RUNNER_JWT_AUDIENCE=vericov-runner-upload
VERICOV_GITHUB_ACTIONS_OIDC_JWKS_URL=https://token.actions.githubusercontent.com/.well-known/jwks

# PostgREST
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

# Storage
STORAGE_BACKEND=file
GLOBAL_S3_BUCKET=vericov-storage
GLOBAL_S3_ENDPOINT=
GLOBAL_S3_PROTOCOL=https
GLOBAL_S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REGION=local
STORAGE_TENANT_ID=vericov
STORAGE_FILE_SIZE_LIMIT=104857600
TUS_ALLOW_S3_TAGS=false
IMGPROXY_AUTO_WEBP=true
